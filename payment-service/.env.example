# Application Configuration
APP_ENV=development
APP_PORT=8083
SERVER_TIMEOUT=10

# External Service URLs (Internal Network)
ORDER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8080

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=sayur_payment_service
DATABASE_MAX_OPEN_CONNECTION=10
DATABASE_MAX_IDLE_CONNECTION=20

# JWT secret key for signing tokens
JWT_SECRET_KEY=your-secret-key-here
# Internal API communication secret key
INTERNAL_KEY=internal-secret

# Redis Configuration (Caching and Sessions)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration (Event Broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key-here
# Midtrans Environment (1 for Sandbox, 2 for Production)
MIDTRANS_ENVIRONMENT=1

# RabbitMQ Publisher Configurations
PUBLISHER_PAYMENT_SUCCESS=payment-success

# RabbitMQ Exchange Names
EXCHANGE_PAYMENT_EVENT=payment.event
EXCHANGE_USER_EVENT=user.event
EXCHANGE_ORDER_EVENT=order.event

# RabbitMQ Queue Names for Consumers
QUEUE_USER_SNAPSHOT_DB=user.snapshot.payment.db
QUEUE_ORDER_SNAPSHOT_DB=order.snapshot.payment.db
