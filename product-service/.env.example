# Application Configuration
APP_PORT=8081
APP_ENV=development
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=product_db
DATABASE_MAX_OPEN_CONNECTION=100
DATABASE_MAX_IDLE_CONNECTION=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_STOCK_UPDATE=product_stock_update

# Elasticsearch Configuration
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=password

# Supabase Storage Configuration
SUPABASE_STORAGE_URL=https://your-project-id.supabase.co
SUPABASE_STORAGE_KEY=your-supabase-key
SUPABASE_STORAGE_BUCKET=products

# Messaging Names
EXCHANGE_PRODUCT_EVENT=product_event_exchange
QUEUE_PRODUCT_ES=product_es_indexing_queue
