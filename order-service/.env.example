# Application Port
APP_PORT=8080
# Application Environment (development, production)
APP_ENV=development
# JWT secret key for signing tokens
JWT_SECRET_KEY=your-secret-key-here
# Server timeout in seconds
SERVER_TIMEOUT=30
# Product Service URL
PRODUCT_SERVICE_URL=http://localhost:8081
# User Service URL
USER_SERVICE_URL=http://localhost:8082
# Reference Latitude for distance calculation
LATITUDE_REF=-6.200000
# Reference Longitude for distance calculation
LONGITUDE_REF=106.816666
# Maximum allowed distance for shipping
MAX_DISTANCE=50
# Internal Key for service-to-service communication
INTERNAL_KEY=your-internal-key

# PostgreSQL Host
DATABASE_HOST=localhost
# PostgreSQL Port
DATABASE_PORT=5432
# PostgreSQL Username
DATABASE_USER=postgres
# PostgreSQL Password
DATABASE_PASSWORD=password
# PostgreSQL Database Name
DATABASE_NAME=order_db
# PostgreSQL Maximum Open Connections
DATABASE_MAX_OPEN_CONNECTION=100
# PostgreSQL Maximum Idle Connections
DATABASE_MAX_IDLE_CONNECTION=10

# Redis Host
REDIS_HOST=localhost
# Redis Port
REDIS_PORT=6379
# Redis Password
REDIS_PASSWORD=
# Redis Database Index
REDIS_DB=0

# RabbitMQ Host
RABBITMQ_HOST=localhost
# RabbitMQ Port
RABBITMQ_PORT=5672
# RabbitMQ Username
RABBITMQ_USERNAME=guest
# RabbitMQ Password
RABBITMQ_PASSWORD=guest

# Publisher Name for Product Stock Update
PUBLISHER_PRODUCT_UPDATE_STOCK=product_update_stock
# Publisher Name for Order Events
PUBLISHER_ORDER=order_event
# Publisher Name for Email Update Status
EMAIL_UPDATE_STATUS=email_update_status
# Publisher Name for Status Update
PUBLISHER_UPDATE_STATUS=update_status

# Exchange Name for Order Events
EXCHANGE_ORDER_EVENT=order_exchange
# Exchange Name for Payment Events
EXCHANGE_PAYMENT_EVENT=payment_exchange
# Exchange Name for User Events
EXCHANGE_USER_EVENT=user_exchange
# Exchange Name for Product Events
EXCHANGE_PRODUCT_EVENT=product_exchange

# Queue Name for Updating Payment Method in DB
QUEUE_UPDATE_PAYMENT_METHOD_DB=update_payment_method_db
# Queue Name for Updating Payment Method in ES
QUEUE_UPDATE_PAYMENT_METHOD_ES=update_payment_method_es
# Queue Name for User Snapshot
QUEUE_USER_SNAPSHOT_DB=user_snapshot_db
# Queue Name for Product Snapshot
QUEUE_PRODUCT_SNAPSHOT_DB=product_snapshot_db

# Elasticsearch Host
ELASTICSEARCH_HOST=http://localhost:9200
# Elasticsearch Username
ELASTICSEARCH_USERNAME=elastic
# Elasticsearch Password
ELASTICSEARCH_PASSWORD=password
