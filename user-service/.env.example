# Application environment (e.g., development, production)
APP_ENV=development

# Application port to listen on
APP_PORT=8080

# Postgres database host
DATABASE_HOST=localhost

# Postgres database port
DATABASE_PORT=5432

# Postgres database user
DATABASE_USER=postgres

# Postgres database password
DATABASE_PASSWORD=your_db_password

# Postgres database name
DATABASE_NAME=sayur_user_service

# Postgres maximum open connections
DATABASE_MAX_OPEN_CONNECTION=10

# Postgres maximum idle connections
DATABASE_MAX_IDLE_CONNECTION=20

# JWT secret key for signing tokens
JWT_SECRET_KEY=your_jwt_secret_key

# JWT issuer name
JWT_ISSUER=your_jwt_issuer

# Redis cache host
REDIS_HOST=localhost

# Redis cache port
REDIS_PORT=6379

# Redis cache password (leave empty if none)
REDIS_PASSWORD=

# Redis cache database index
REDIS_DB=0

# RabbitMQ message broker host
RABBITMQ_HOST=localhost

# RabbitMQ message broker port
RABBITMQ_PORT=5672

# RabbitMQ username
RABBITMQ_USERNAME=guest

# RabbitMQ password
RABBITMQ_PASSWORD=guest

# Frontend URL for password reset links
URL_FORGOT_PASSWORD=http://localhost:3000

# Base Frontend URL
URL_FRONTEND=http://localhost:3000

# Exchange name for publishing user events (e.g., user creation/updates)
EXCHANGE_USER_EVENT=user.event

# Supabase Storage API URL
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# Supabase Storage Service Key
SUPABASE_STORAGE_KEY=your_supabase_service_key

# Supabase Storage Bucket name
SUPABASE_STORAGE_BUCKET=your_bucket_name
